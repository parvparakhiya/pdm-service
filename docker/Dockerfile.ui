# syntax=docker/dockerfile:1.7
#
# Operator console. Separate image from the API so the two can be scaled,
# restarted and rolled back independently — and so a crashed API is visible as
# a failed container rather than hidden behind a still-running Streamlit.
FROM python:3.11-slim AS builder

ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /build
COPY requirements/ui.txt requirements/ui.txt
RUN python -m venv /opt/venv && /opt/venv/bin/pip install -r requirements/ui.txt


FROM python:3.11-slim AS runtime

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PATH="/opt/venv/bin:$PATH"

# `apt-get upgrade` applies Debian security updates that the published base
# image has not been rebuilt with yet. Without it the image ships known-fixed
# CVEs until upstream cuts a new tag, and the CI vulnerability gate fails on
# findings that are not ours to fix in code. The cost is that the OS layer is
# no longer byte-reproducible -- pin the base by digest to bound that.
RUN apt-get update \
 && apt-get upgrade -y --no-install-recommends \
 && apt-get install -y --no-install-recommends tini curl \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --gid 10001 app \
 && useradd --uid 10001 --gid app --no-create-home --shell /usr/sbin/nologin app

COPY --from=builder /opt/venv /opt/venv
WORKDIR /app
COPY --chown=app:app ui/ ui/

USER app
EXPOSE 8501

HEALTHCHECK --interval=20s --timeout=3s --start-period=15s --retries=3 \
  CMD curl -fsS http://localhost:8501/_stcore/health || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["streamlit", "run", "ui/app.py", \
     "--server.port=8501", "--server.address=0.0.0.0", \
     "--server.headless=true", "--browser.gatherUsageStats=false"]
