# Copy to .env and fill in. .env is gitignored and dockerignored.

# local | dev | staging | prod
# staging and prod refuse to start without PDM_API_KEYS.
PDM_ENVIRONMENT=dev
PDM_LOG_LEVEL=INFO
PDM_LOG_FORMAT=json

# Comma-separated. Generate with: openssl rand -hex 32
PDM_API_KEYS=change-me-please
PDM_UI_API_KEY=change-me-please

PDM_RATE_LIMIT_PER_MINUTE=600
PDM_CORS_ALLOW_ORIGINS=

# --- optional learned model -------------------------------------------------
# Leave empty unless the training pipeline's ship/no-ship gate approved one.
# The artifact must sit in models/ next to a <name>.contract.json whose digest
# matches the service's FEATURE_ORDER, or it is refused at startup.
PDM_ONNX_CLASSIFIER=

# --- decision policy --------------------------------------------------------
# Changing any of these changes the policy fingerprint recorded on every
# prediction. Treat as a code change: review it, do not hotfix it.
PDM_HAZARD_HORIZON_MINUTES=10
PDM_HAZARD_STOP_PROBABILITY=0.60
PDM_HAZARD_SCHEDULE_PROBABILITY=0.20
PDM_MARGIN_WARNING_FRACTION=0.80
PDM_MARGIN_CRITICAL_FRACTION=0.95

# --- joint physics plausibility ---------------------------------------------
# Catches readings whose channels are individually in range but jointly
# impossible - the signature of a failed transducer, not a machine fault.
# Do NOT widen these to silence an alarm; they are what stops an instrument
# fault from being reported as a breach.
PDM_PLAUSIBILITY_ENABLED=true
PDM_IMPLAUSIBLE_POWER_FACTOR=1.5
PDM_IMPLAUSIBLE_DELTA_T_MAX_K=20
PDM_IMPLAUSIBLE_DELTA_T_MIN_K=0

# Asset registry. Empty accepts any machine_id (local only). Set it in
# staging/prod so a typo cannot create a phantom machine in the audit log.
PDM_KNOWN_MACHINE_IDS=

# --- cost model -------------------------------------------------------------
# PLACEHOLDERS. Replace with figures agreed with finance and maintenance before
# go-live; every escalation threshold is justified against these.
PDM_COST_MISSED_FAILURE=12000
PDM_COST_FALSE_ALARM=350
PDM_COST_PLANNED_STOP=900
